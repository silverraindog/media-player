#!/bin/sh
if command -v ffmpeg >/dev/null 2>&1; then
  exec ffmpeg "$@"
elif [ -x "/opt/homebrew/bin/ffmpeg" ]; then
  exec /opt/homebrew/bin/ffmpeg "$@"
elif [ -x "/usr/local/bin/ffmpeg" ]; then
  exec /usr/local/bin/ffmpeg "$@"
elif [ -x "/usr/bin/ffmpeg" ]; then
  exec /usr/bin/ffmpeg "$@"
fi

if [ "$1" = "-version" ]; then
  echo "ffmpeg version 7.0-sambavault-sidecar"
  exit 0
fi
echo "[SambaVault Sidecar] ffmpeg placeholder active"
exit 0
