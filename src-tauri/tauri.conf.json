{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.sambavault.app",
  "productName": "SambaVault",
  "version": "1.0.0",
  "app": {
    "windows": [
      {
        "title": "SambaVault",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "build": {
    "frontendDist": "../dist-frontend"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}