{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist"
  },
  "package": {
    "productName": "SambaVault",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.sambavault.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "macOS": {
        "infoPlist": {
          "NSLocalNetworkUsageDescription": "SambaVault needs local network access to connect to your NAS and Samba shares."
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "SambaVault & Metadata Manager",
        "width": 1280,
        "height": 800
      }
    ]
  }
}

